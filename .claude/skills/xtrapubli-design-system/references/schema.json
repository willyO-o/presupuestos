        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "auto_increment": true
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "email",
          "type": "string",
          "unique": true
        },
        {
          "name": "email_verified_at",
          "type": "timestamp",
          "nullable": true
        },
        {
          "name": "password",
          "type": "string"
        },
        {
          "name": "foto",
          "type": "string",
          "nullable": true,
          "comment": "ruta/URL de la foto de perfil"
        },
        {
          "name": "estado",
          "type": "enum",
          "values": [
            "ACTIVO",
            "INACTIVO"
          ],
          "default": "ACTIVO"
        },
        {
          "name": "remember_token",
          "type": "string",
          "nullable": true
        },
        {
          "name": "created_at",
          "type": "timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp"
        }
      ],
      "indexes": [
        {
          "columns": [
            "email"
          ],
          "unique": true
        }
      ]
    },
