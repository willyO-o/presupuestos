        {
          "name": "precio_presentacion",
          "type": "decimal(10,2)",
          "comment": "costo total del rollo/plancha/litro"
        },
        {
          "name": "precio_unitario",
          "type": "decimal(10,2)",
          "comment": "costo por m2/metro/unidad, usado en el calculo de cotizaciones"
        },
        {
          "name": "stock_actual",
          "type": "decimal(10,2)",
          "default": 0
        },
        {
          "name": "stock_minimo",
          "type": "decimal(10,2)",
          "default": 0
        },
        {
          "name": "redondeo_compra",
          "type": "decimal(10,4)",
          "nullable": true,
          "comment": "multiplo (en unidad_medida) al que CosteoProductoService redondea hacia arriba la cantidad consumida: se compra en unidades enteras (plancha, barra 6m, galon) y el sobrante no se reutiliza. null = cantidad exacta (corte de rollo). Agregado 2026-08-28."
        },
        {
          "name": "estado",
          "type": "enum",
          "values": [
            "ACTIVO",
            "INACTIVO"
          ],
          "default": "ACTIVO"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp"
        }
      ]
