    {
      "table": "formula",
      "description": "Fórmulas reutilizables para calcular dinámicamente cuánto material consume una línea de producto_material, cuando un factor fijo no alcanza (ej. letras corpóreas 3D: área de cara + perímetro de canto + profundidad). Agregada 2026-08-25, evaluada con nxp/math-executor vía App\\Services\\Calculo\\FormulaCalculator — ver .ai/rules/migrations.md.",
      "columns": [
        {
          "name": "id",
          "type": "bigint",
          "pk": true,
          "auto_increment": true
        },
        {
          "name": "nombre",
          "type": "string"
        },
        {
          "name": "expresion",
          "type": "string",
          "comment": "ej. (ancho + alto) * 2 * profundo — variables disponibles: ancho, alto, profundo, area, perimetro"
        },
        {
          "name": "descripcion",
          "type": "text",
          "nullable": true
        },
        {
          "name": "estado",
          "type": "enum",
          "values": ["ACTIVO", "INACTIVO"],
          "default": "ACTIVO"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        },
        {
          "name": "updated_at",
          "type": "timestamp"
        }
      ]
    },
